# Copie para .env e preencha. NUNCA commite o .env real.
# Gmail (via conector Grok — não precisa de token aqui)
# GMAIL_USER=

# GitHub (use `gh auth login` no box; não versione token)
# GH_TOKEN=

# Vercel (via conector Grok)
# VERCEL_TOKEN=

# VPN (via `vpn` CLI no box)
# VPN_AUTHKEY=

# AdGuardHome
# ADGUARD_URL=http://127.0.0.1:3000
# ADGUARD_USER=
# ADGUARD_PASS=

# Meta WhatsApp Cloud API (projeto suspenso — mantido só como referência)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=

# Tray e-commerce (projeto suspenso)
# TRAY_CONSUMER_KEY=
# TRAY_CONSUMER_SECRET=
